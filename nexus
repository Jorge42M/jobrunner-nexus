#!/usr/bin/env bash
# Atajo para usar Nexus sin instalar nada.
# Ejemplo:  ./nexus serve      ./nexus submit sleep 5      ./nexus list
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PYTHONPATH="$DIR/src${PYTHONPATH:+:$PYTHONPATH}"
export NEXUS_HOME="${NEXUS_HOME:-$DIR/nexus-data}"
exec python3 -m nexus "$@"
